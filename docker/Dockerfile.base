# Flakebait base image: one per Java version (JAVA=8|11|17).
# Native arm64 replacement for ReproFlake's maven:3.8.6-openjdk-* images (see deviations.md #2).
ARG JAVA=8

# Stage 1: build ReproFlake's tooling once, on Java 8, into a standalone local repo.
FROM maven:3.8.6-eclipse-temurin-8 AS tools
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
ENV R=/opt/fb/tools-m2
# Custom Surefire with -Dsurefire.runOrder=testorder (ReproFlake's OD configuration).
RUN git clone -q https://github.com/TestingResearchIllinois/maven-surefire.git /src/surefire \
 && cd /src/surefire && git rev-parse HEAD > /opt/surefire.commit \
 && mvn -q -Dmaven.repo.local=$R install -DskipTests -Drat.skip -Denforcer.skip \
 && mkdir -p /opt/fb/od-ext \
 && cp surefire-changing-maven-extension/target/surefire-changing-maven-extension-1.0-SNAPSHOT.jar /opt/fb/od-ext/
# Warm the repo with NonDex and plain Surefire/JUnit by running them on a tiny project.
COPY warmup /src/warmup
RUN cd /src/warmup \
 && mvn -q -Dmaven.repo.local=$R test \
 && mvn -q -Dmaven.repo.local=$R edu.illinois:nondex-maven-plugin:2.1.1:nondex -DnondexRuns=1 \
 && mvn -q -Dmaven.repo.local=$R -Dmaven.ext.class.path=/opt/fb/od-ext/surefire-changing-maven-extension-1.0-SNAPSHOT.jar \
        test -Dsurefire.runOrder=testorder -Dtest=fb.WarmupTest#a,fb.WarmupTest#b

# Stage 2: the runtime image.
FROM maven:3.8.6-eclipse-temurin-${JAVA}
RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3 patch rsync xmlstarlet libxml2-utils ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=tools /opt/fb /opt/fb
COPY --from=tools /opt/surefire.commit /opt/fb/surefire.commit
RUN git config --system --add safe.directory '*'
