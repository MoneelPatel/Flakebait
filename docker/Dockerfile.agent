# Agent image: the instance's build environment plus a headless coding agent.
# fb-ext sits in Maven's lib/ext, so every Surefire fork relays the flaky test's outcome from the oracle.
ARG JAVA=8
FROM fb-base:${JAVA}
ARG NODE_VERSION=20.18.0
ARG CLAUDE_CODE_VERSION=2.1.308
USER root
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils && rm -rf /var/lib/apt/lists/*
RUN ARCH=$(dpkg --print-architecture | sed 's/amd64/x64/') \
 && curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.xz \
    | tar -xJ -C /usr/local --strip-components=1 \
 && npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
 && npm cache clean --force
COPY fb-ext.jar /usr/share/maven/lib/ext/fb-ext.jar
RUN useradd -m -u 1000 -s /bin/bash dev && mkdir -p /work && chown dev /work
USER dev
ENV MAVEN_CONFIG=/home/dev/.m2
WORKDIR /work
# The Maven image's entrypoint copies settings into /root; not needed for a non-root user.
ENTRYPOINT []
